{
  "name": "flownova-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "FlowNova AI Windows desktop client for the hosted workflow workbench",
  "author": "FlowNova AI contributors",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test policy.test.cjs",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ai.flownova.desktop",
    "productName": "FlowNova AI",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.cjs", "policy.cjs", "shell.html", "build/icon.png", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "FlowNova-AI-${version}-windows-${arch}.${ext}",
      "signExecutable": false
    },
    "portable": { "requestExecutionLevel": "user" }
  }
}
